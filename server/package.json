{
    "name": "drim-server",
    "version": "1.0.0",
    "description": "梦见小程序后端服务",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "rm -f tsconfig.build.tsbuildinfo && nest build",
        "start": "node dist/main",
        "predev": "./scripts/ensure-db.sh && prisma generate && ./scripts/kill-port.sh",
        "dev": "nest start --watch",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
        "db:studio": "prisma studio",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:start": "docker compose up mysql -d",
        "docker:stop": "docker compose stop"
    },
    "prisma": {
        "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
    },
    "overrides": {
        "@tiptap/extension-blockquote": "2.1.13",
        "@tiptap/extension-bold": "2.1.13",
        "@tiptap/extension-bullet-list": "2.1.13",
        "@tiptap/extension-code-block": "2.1.13",
        "@tiptap/extension-dropcursor": "2.1.13",
        "@tiptap/extension-gapcursor": "2.1.13",
        "@tiptap/extension-hard-break": "2.1.13",
        "@tiptap/extension-history": "2.1.13",
        "@tiptap/extension-horizontal-rule": "2.1.13",
        "@tiptap/extension-italic": "2.1.13",
        "@tiptap/extension-list-item": "2.1.13",
        "@tiptap/extension-ordered-list": "2.1.13",
        "@tiptap/extension-paragraph": "2.1.13",
        "@tiptap/extension-strike": "2.1.13"
    },
    "dependencies": {
        "@adminjs/express": "6.1.1",
        "@adminjs/prisma": "5.0.4",
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.0.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/schedule": "^6.1.0",
        "@nestjs/swagger": "^7.1.17",
        "@nestjs/terminus": "^11.0.0",
        "@prisma/client": "^5.7.0",
        "adminjs": "7.8.17",
        "axios": "^1.6.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "express-formidable": "1.2.0",
        "express-session": "1.18.2",
        "memorystore": "1.6.8",
        "multer": "^2.0.0",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/express": "^4.17.17",
        "@types/express-session": "1.18.2",
        "@types/jest": "^29.5.2",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.3.1",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.5.0",
        "prettier": "^3.0.0",
        "prisma": "^5.7.0",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
